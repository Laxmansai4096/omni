# Azure AI Document Intelligence Settings
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_doc_intel_key_here

# Azure OpenAI / Vision Settings (Optional for chart/graph deep analysis)
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure Storage Settings (Optional for persistent raw document blobs)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER_NAME=raw-documents

# Azure Service Bus Settings (Decoupled Asynchronous Processing)
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<your-namespace>.servicebus.windows.net/...
AZURE_SERVICE_BUS_QUEUE_NAME=ai-jobs-queue
AZURE_SERVICE_BUS_RESULTS_QUEUE=ai-results-queue
ENABLE_ASYNC_WORKER=true

# Azure Application Insights & OpenTelemetry Distributed Tracing
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
OTEL_SERVICE_NAME=omnidoc-fde-platform

# Platform Security & Concurrency Limits
MAX_CONCURRENT_USERS=10
MAX_FILE_SIZE_MB=20
DEMO_MODE=false
